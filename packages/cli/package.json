{
  "name": "@txtadev/cli",
  "version": "0.1.3",
  "description": "Send encrypted letters to developers through recipient-owned GitHub issues",
  "license": "MIT",
  "type": "module",
  "bin": {
    "txtadev": "dist/run.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./run": "./dist/run.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smashah/txta-cli.git",
    "directory": "packages/cli"
  },
  "homepage": "https://txta.dev",
  "bugs": {
    "url": "https://github.com/smashah/txta-cli/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts src/run.ts src/cli.ts --format esm --dts --clean",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "age-encryption": "0.3.0",
    "effect": "4.0.0-beta.94",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@types/ssh2": "1.15.5"
  }
}
